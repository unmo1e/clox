fun vec() {
  var x;
  var y;
  
  fun get(dim) {
    if(dim == "x")
      return x;
    else
      return y;
  }

  fun set(dim, val) {
    if(dim == "x")
      x = val;
    else
      y = val;
  }

  fun api(x) {
    if(x == "get")
      return get;
    else
      return set;
  }

  return api;
}

var v1 = vec();

v1("set")("x", 10);
print v1("get")("x");
