fun vec() {
  var x = 10;
  var y = 10;

  fun get(name) {
    if(name == "x")
      return x;
    else
      return y;
  }

  fun set(name, val) {
    if(name == "x")
      x = val;
    else
      y = val;
  }

  fun method(name) {
    if(name == "get")
      return get;
    else
      return set;
  }
  
  return method;
}

var v1 = vec();
print v1("get")("x");

v1("set")("x", 20);
print v1("get")("x");
